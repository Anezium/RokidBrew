<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ar_black"
    android:orientation="vertical"
    android:paddingStart="28dp"
    android:paddingTop="22dp"
    android:paddingEnd="28dp"
    android:paddingBottom="18dp">

    <TextView
        android:id="@+id/headerText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="RokidBrew"
        android:textColor="@color/ar_green"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/appNameText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:singleLine="true"
        android:textColor="@color/ar_text"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/metaText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:textColor="@color/ar_blue"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/summaryText"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:maxLines="4"
        android:textColor="@color/ar_muted"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/actionText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#101C17"
        android:padding="12dp"
        android:textColor="@color/ar_green"
        android:textSize="18sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/gridPreview"
        android:layout_width="match_parent"
        android:layout_height="86dp"
        android:layout_marginTop="12dp"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:maxLines="3"
        android:textColor="@color/ar_muted"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/helpText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="D-pad left/right: browse grid  /  center: install"
        android:textColor="@color/ar_dim"
        android:textSize="12sp" />
</LinearLayout>
