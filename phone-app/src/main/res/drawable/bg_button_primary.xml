<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#070E08" />
            <corners android:radius="10dp" />
            <stroke
                android:width="1dp"
                android:color="#162A19" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#1A4D1F" />
            <corners android:radius="10dp" />
            <stroke
                android:width="1.5dp"
                android:color="#39FF14" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0F2613" />
            <corners android:radius="10dp" />
            <stroke
                android:width="1.5dp"
                android:color="#39FF14" />
        </shape>
    </item>
</selector>
